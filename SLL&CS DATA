<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-g">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School of Language - Election Dashboard</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Load Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 p-4 md:p-8">

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <h1 class="text-3xl font-bold text-gray-800 mb-6">School of Language - Election Dashboard</h1>

        <!-- Key Metrics Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Card 1: Total Registered 2024 -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-sm font-medium text-gray-500">Total Registered Students in 2024 election</h3>
                <p id="totalRegistered2024" class="text-3xl font-semibold text-gray-900 mt-2">--</p>
            </div>
            <!-- Card 2: Total Registered 2025 -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-sm font-medium text-gray-500">Total Registered Students in 2025 election</h3>
                <p id="totalRegistered2025" class="text-3xl font-semibold text-gray-900 mt-2">--</p>
            </div>
            <!-- Card 3: Voter Turnout 2024 -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-sm font-medium text-gray-500">Voter Turnout (2024-25)</h3>
                <p id="turnout2024" class="text-3xl font-semibold text-blue-600 mt-2">--</p>
                <p id="votesRegistered2024" class="text-xs text-gray-500 mt-1">--</p>
            </div>
            <!-- Card 4: Voter Turnout 2025 -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-sm font-medium text-gray-500">Voter Turnout (2025-26)</h3>
                <p id="turnout2025" class="text-3xl font-semibold text-green-600 mt-2">--</p>
                <p id="votesRegistered2025" class="text-xs text-gray-500 mt-1">--</p>
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <!-- Chart 1: Registered Students per Centre -->
            <div class="bg-white p-6 rounded-lg shadow-md col-span-1 lg:col-span-2">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Registered Students per Centre (2024 vs 2025)</h2>
                <div class="h-96">
                    <canvas id="centreChart"></canvas>
                </div>
            </div>

            <!-- Chart 2: Candidate Votes 2024 -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Candidate Votes (2024)</h2>
                <div class="h-80">
                    <canvas id="votes2024Chart"></canvas>
                </div>
            </div>

            <!-- Chart 3: Candidate Votes 2025 -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Candidate Votes (2025)</h2>
                <div class="h-80">
                    <canvas id="votes2025Chart"></canvas>
                </div>
            </div>

        </div>
    </div>

    <script>
        // Data parsed from the document
        const summaryData = {
            totalRegistered2024: 2472, // User corrected from 2500
            totalRegistered2025: 2344, // User corrected from 2500
            totalCentres: 12
        };

        const candidateData = [
            { name: "Prafulla Kumar Singh", centre: "CKS (Korean)", votes: 460, year: 2024 },
            { name: "Kuldeep Singh", centre: "CRS (Russian)", votes: 293, year: 2025 },
            { name: "Vikash Paliwal", centre: "CGS (German)", votes: 447, year: 2024 },
            { name: "Garima Kanwar", centre: "CGS (German)", votes: 287, year: 2025 },
            // Note: Priyanshu Kashyap ran both years, listed separately
            { name: "Priyanshu Kashyap", centre: "CGS (German)", votes: 419, year: 2024 }, 
            { name: "Priyanshu Kashyap", centre: "CGS (German)", votes: 269, year: 2025 },
            { name: "Aayush Kumar Mishra", centre: "CPCAS(Pashto)", votes: 297, year: 2024 },
            { name: "Utkarsh Dubey", centre: "CFFS (French)", votes: 237, year: 2025 },
            { name: "Vaibhav Meena", centre: "CIL (Hindi)", votes: 292, year: 2024 },
            { name: "Suhail Raza", centre: "CPCAS (Persian)", votes: 212, year: 2025 },
            { name: "Jaya Choubey", centre: "CFFS (French)", votes: 266, year: 2024 },
            { name: "Ashwini Kumar Maurya", centre: "CGS (German)", votes: 170, year: 2025 }
        ];

        const centreData = [
            { name: "CCEAS", registered2024: 138, registered2025: 178 },
            { name: "CES", registered2024: 129, registered2025: 132 },
            { name: "CFFS", registered2024: 246, registered2025: 261 },
            { name: "Japanese Studies", registered2024: 186, registered2025: 214 },
            { name: "CIL", registered2024: 296, registered2025: 311 },
            { name: "CAAS", registered2024: 195, registered2025: 220 },
            { name: "CKS", registered2024: 185, registered2025: 200 },
            { name: "CLIN", registered2024: 93, registered2025: 104 },
            { name: "CRS", registered2024: 224, registered2025: 272 },
            { name: "CSPILAS", registered2024: 189, registered2025: 211 },
            { name: "CPCS", registered2024: 236, registered2025: 262 },
            { name: "CGS", registered2024: 227, registered2025: 269 }
        ];

        // Wait for the DOM to load before running scripts
        document.addEventListener('DOMContentLoaded', () => {
            
            // --- 1. Populate Key Metrics ---
            
            // Use user-provided total votes for 2024
            const totalVotes2024 = 1735;
            // Note: The sum of individual 2024 candidates in the doc is 2181.
            // We are using the user's corrected total of 1735 for the metric card.
                
            // Use user-provided total votes for 2025
            const totalVotes2025 = 1609;
            // Note: The sum of individual 2025 candidates in the doc is 1468.
            // We are using the user's corrected total of 1609 for the metric card.

            // Calculate turnout
            const turnout2024 = (totalVotes2024 / summaryData.totalRegistered2024) * 100;
            const turnout2025 = (totalVotes2025 / summaryData.totalRegistered2025) * 100;

            // Update HTML
            document.getElementById('totalRegistered2024').textContent = summaryData.totalRegistered2024.toLocaleString();
            document.getElementById('totalRegistered2025').textContent = summaryData.totalRegistered2025.toLocaleString();
            
            document.getElementById('turnout2024').textContent = `${turnout2024.toFixed(2)}%`;
            document.getElementById('votesRegistered2024').textContent = `${totalVotes2024.toLocaleString()} votes out of ${summaryData.totalRegistered2024.toLocaleString()}`;
            
            document.getElementById('turnout2025').textContent = `${turnout2025.toFixed(2)}%`;
            document.getElementById('votesRegistered2025').textContent = `${totalVotes2025.toLocaleString()} votes out of ${summaryData.totalRegistered2025.toLocaleString()}`;

            
            // --- 2. Create Centre Registration Chart ---
            const ctxCentre = document.getElementById('centreChart').getContext('2d');
            new Chart(ctxCentre, {
                type: 'bar',
                data: {
                    labels: centreData.map(c => c.name),
                    datasets: [
                        {
                            label: 'Registered 2024',
                            data: centreData.map(c => c.registered2024),
                            backgroundColor: 'rgba(59, 130, 246, 0.7)', // Blue
                            borderColor: 'rgba(59, 130, 246, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Registered 2025',
                            data: centreData.map(c => c.registered2025),
                            backgroundColor: 'rgba(16, 185, 129, 0.7)', // Green
                            borderColor: 'rgba(16, 185, 129, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    }
                }
            });

            // --- 3. Create Candidate Votes 2024 Chart ---
            const candidates2024 = candidateData.filter(c => c.year === 2024);
            const ctxVotes2024 = document.getElementById('votes2024Chart').getContext('2d');
            new Chart(ctxVotes2024, {
                type: 'bar',
                data: {
                    labels: candidates2024.map(c => `${c.name} (${c.centre})`),
                    datasets: [{
                        label: 'Votes 2024',
                        data: candidates2024.map(c => c.votes),
                        backgroundColor: 'rgba(59, 130, 246, 0.7)',
                        borderColor: 'rgba(59, 130, 246, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y', // Horizontal bar chart
                    scales: {
                        x: {
                            beginAtZero: true
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });

            // --- 4. Create Candidate Votes 2025 Chart ---
            const candidates2025 = candidateData.filter(c => c.year === 2025);
            const ctxVotes2025 = document.getElementById('votes2025Chart').getContext('2d');
            new Chart(ctxVotes2025, {
                type: 'bar',
                data: {
                    labels: candidates2025.map(c => `${c.name} (${c.centre})`),
                    datasets: [{
                        label: 'Votes 2025',
                        data: candidates2025.map(c => c.votes),
                        backgroundColor: 'rgba(16, 185, 129, 0.7)',
                        borderColor: 'rgba(16, 185, 129, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y', // Horizontal bar chart
                    scales: {
                        x: {
                            beginAtZero: true
                        }
                    },
                     plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>






